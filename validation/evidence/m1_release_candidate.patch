+def test_rater_contrast_distinguishes_fixed_values_and_anchor_dependent_links():
+    data = pd.DataFrame({"Work": ["1", "1", "2", "2"], "Rater": ["A", "B", "C", "D"],
+                         "Score": [0, 1, 0, 1]})
